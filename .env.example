PUBLIC_BASE_URL=https://mcp.example.nl
PORT=8080
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
EXACT_REDIRECT_URI=https://mcp.example.nl/exact/callback
EXACT_DEFAULT_REGION=nl
# Comma-separated regions shown on the login page (default: only the default region)
EXACT_ENABLED_REGIONS=nl
# generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# generate: openssl rand -base64 48
SESSION_SIGNING_KEY=
ENABLE_WRITE_TOOLS=false
ALLOWED_EXACT_USER_IDS=
# Extra redirect URIs (comma-separated) on top of claude.ai / claude.com / localhost
EXTRA_REDIRECT_URIS=
DB_PATH=/data/connector.db
# Exact budget per division and client-error breaker per endpoint
EXACT_RATE_PER_MINUTE=50
EXACT_RATE_PER_DAY=4500
EXACT_BREAKER_ERRORS=8
# Workload callers with OIDC access tokens (all three required together)
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXACT_USER_ID=
JWT_ALLOWED_CLIENTS=
# Ledger and audit database; empty keeps the bookkeeping write tools disabled
DATABASE_URL=
# generate: openssl rand -base64 48
APPROVAL_SIGNING_KEY=
TIER_AUTO_MAX_EUR=250
TIER_AUTO_MIN_SUPPLIER_ENTRIES=3
TIER_AUTO_HOLD_HOURS=24
TIER_TWO_STEP_ABOVE_EUR=5000
TIER_BALANCE_ACCOUNT_ALLOWLIST=
TIER_PAYROLL_JOURNALS=
ENABLE_MATCHSETS=false
# approval answer patterns (case-insensitive); empty: built-in defaults
APPROVAL_ANSWER_APPROVE=
APPROVAL_ANSWER_REJECT=
EXACT_PROCESS_MODE=record
LOG_LEVEL=info
# Cloudflare Tunnel token (compose profile)
TUNNEL_TOKEN=
