PUBLIC_BASE_URL=https://mcp.example.nl
PORT=8080
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
EXACT_REDIRECT_URI=https://mcp.example.nl/exact/callback
EXACT_DEFAULT_REGION=nl
# Comma-separated regions shown on the login page (default: only the default region)
EXACT_ENABLED_REGIONS=nl
# generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# generate: openssl rand -base64 48
SESSION_SIGNING_KEY=
ENABLE_WRITE_TOOLS=false
ALLOWED_EXACT_USER_IDS=
# Extra redirect URIs (comma-separated) on top of claude.ai / claude.com / localhost
EXTRA_REDIRECT_URIS=
DB_PATH=/data/connector.db
LOG_LEVEL=info
# Cloudflare Tunnel token (compose profile)
TUNNEL_TOKEN=
